-- Trova elementi importanti nel workspace
local Stages = nil
local ClaimGoldEvent = nil
local ChangeCharacterEvent = nil
local Treasure = nil

local function InitializeGameObjects()
    -- Trova gli stage
    local success, result = pcall(function()
        return Workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")
    end)
    if success then
        Stages = result
    end
    
    -- Trova eventi remoti
    pcall(function()
        ClaimGoldEvent = Workspace:WaitForChild("ClaimRiverResultsGold")
        ChangeCharacterEvent = Workspace:WaitForChild("ChangeCharacter")
    end)
    
    -- Trova il tesoro
    pcall(function()
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name == "Treasure" or obj.Name:find("Chest") then
                Treasure = obj
                break
            end
        end
    end)
end

