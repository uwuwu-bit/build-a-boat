-- Funzione per trovare i Gold Blocks
local function GetGoldBlocks()
    local blocks = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "GoldBlock" or obj.Name:find("Gold") and obj:IsA("BasePart") then
            table.insert(blocks, obj)
        end
    end
    return blocks
end

-- Funzione per trovare il tesoro
local function FindTreasure()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "Treasure" or (obj:IsA("BasePart") and obj.Position.Z > 9000) then
            return obj
        end
    end
    return nil
end

-- Funzione Auto Farm Gold (completa tutti gli stage e raccoglie tesoro)
local function AutoFarmGold()
    while Settings.AutoFarmGold do
        local char = LocalPlayer.Character
        if not char then
            LocalPlayer.CharacterAdded:Wait()
            char = LocalPlayer.Character
        end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            wait(1)
            continue
        end
        
        -- Metodo 1: Teleport attraverso gli stage
        if Stages then
            for i = 1, Settings.MaxStages do
                if not Settings.AutoFarmGold then break end
                
                local stage = Stages:FindFirstChild("CaveStage" .. i) or Stages:FindFirstChild("Stage" .. i)
                if stage then
                    local endPart = stage:FindFirstChild("DarknessPart") or stage:FindFirstChild("End") or stage:FindFirstChildWhichIsA("Part")
                    if endPart then
                        -- Teleport al centro dello stage
                        local targetCFrame = CFrame.new(endPart.Position.X, 50, endPart.Position.Z)
                        hrp.CFrame = targetCFrame
                        
                        -- Aspetta il tempo necessario per registrare lo stage
                        wait(Settings.StageDuration)
                    end
                end
            end
        end
        
        -- Metodo 2: Vai direttamente al tesoro
        local treasure = FindTreasure()
        if treasure then
            -- Vai alla posizione del tesoro
            local targetPos = treasure.Position + Vector3.new(0, 10, 0)
            hrp.CFrame = CFrame.new(targetPos)
            wait(0.5)
            
            -- Tocca il tesoro
            if treasure:FindFirstChild("TouchInterest") then
                firetouchinterest(treasure, hrp, 0)
                firetouchinterest(treasure, hrp, 1)
            end
            
            -- Usa l'evento remoto se disponibile
            if ClaimGoldEvent then
                pcall(function()
                    ClaimGoldEvent:FireServer()
                end)
            end
            
            wait(1)
        end
        
        -- Metodo 3: Vai molto lontano (oltre il tesoro) per triggerare il completamento
        hrp.CFrame = CFrame.new(0, 50, 10000)
        wait(0.5)
        
        -- Reset per ripetere
        if ChangeCharacterEvent then
            pcall(function()
                ChangeCharacterEvent:FireServer()
            end)
        else
            -- Se non trova l'evento, usa il metodo alternativo
            char:BreakJoints()
        end
        
        wait(3) -- Attendi respawn
    end
end

-- Funzione Auto Farm Gold Blocks
local function AutoFarmGoldBlocks()
    while Settings.AutoFarmGoldBlocks do
        local blocks = GetGoldBlocks()
        local char = LocalPlayer.Character
        if not char then
            wait(1)
            continue
        end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            wait(1)
            continue
        end
        
        for _, block in pairs(blocks) do
            if not Settings.AutoFarmGoldBlocks then break end
            
            if block and block.Parent then
                -- Teleport al blocco
                hrp.CFrame = CFrame.new(block.Position + Vector3.new(0, 5, 0))
                wait(0.2)
                
                -- Tocca il blocco
                if block:FindFirstChild("TouchInterest") then
                    firetouchinterest(block, hrp, 0)
                    firetouchinterest(block, hrp, 1)
                end
                
                wait(0.1)
            end
        end
        
        wait(1)
    end
end

-- Funzione Fast Farm (ottimizzato per massima velocità)
local function FastFarm()
    while Settings.FastFarm do
        local char = LocalPlayer.Character
        if not char then
            LocalPlayer.CharacterAdded:Wait()
            char = LocalPlayer.Character
        end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            wait(0.5)
            continue
        end
        
        -- Teleport istantaneo alla fine
        hrp.CFrame = CFrame.new(0, 100, 9200) -- Coordinate approssimative del tesoro
        wait(0.3)
        
        -- Trigger evento gold
        if ClaimGoldEvent then
            for i = 1, 3 do -- Fire multiple times per sicurezza
                pcall(function()
                    ClaimGoldEvent:FireServer()
                end)
            end
        end
        
        wait(0.2)
        
        -- Reset veloce
        if ChangeCharacterEvent then
            pcall(function()
                ChangeCharacterEvent:FireServer()
            end)
        else
            char:BreakJoints()
        end
        
        wait(1.5) -- Tempo minimo per respawn
    end
end

-- ESP per Gold Blocks
local ESPFolder = Instance.new("Folder", CoreGui)
ESPFolder.Name = "BABFT_ESP"

local function CreateESP(target, color, label)
    if not target or not target:IsA("BasePart") then return end
    
    -- Rimuovi ESP esistente
    for _, child in pairs(ESPFolder:GetChildren()) do
        if child.Adornee == target then
            child:Destroy()
        end
    end
    
    local esp = Instance.new("BillboardGui")
    esp.Name = "GoldESP"
    esp.AlwaysOnTop = true
    esp.Size = UDim2.new(0, 100, 0, 40)
    esp.StudsOffset = Vector3.new(0, 3, 0)
    esp.Adornee = target
    esp.Parent = ESPFolder
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = color
    frame.BackgroundTransparency = 0.3
    frame.BorderSizePixel = 0
    frame.Parent = esp
    
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 0.5, 0)
    text.Position = UDim2.new(0, 0, 0, 0)
    text.BackgroundTransparency = 1
    text.Text = label
    text.TextColor3 = Color3.new(1, 1, 1)
    text.TextStrokeTransparency = 0
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    text.Parent = esp
    
    local distText = Instance.new("TextLabel")
    distText.Size = UDim2.new(1, 0, 0.5, 0)
    distText.Position = UDim2.new(0, 0, 0.5, 0)
    distText.BackgroundTransparency = 1
    distText.Text = "0 studs"
    distText.TextColor3 = Color3.new(1, 1, 0)
    distText.TextStrokeTransparency = 0
    distText.TextScaled = true
    distText.Font = Enum.Font.Gotham
    distText.Parent = esp
    
    -- Aggiorna distanza
    spawn(function()
        while esp and esp.Parent do
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp and target and target.Parent then
                local distance = (hrp.Position - target.Position).Magnitude
                distText.Text = math.floor(distance) .. " studs"
            end
            wait(0.5)
        end
    end)
end

local function UpdateESP()
    while Settings.ESPGoldBlocks do
        ESPFolder:ClearAllChildren()
        
        local blocks = GetGoldBlocks()
        for _, block in pairs(blocks) do
            if block:IsA("BasePart") then
                CreateESP(block, Color3.fromRGB(255, 215, 0), "GOLD BLOCK")
            end
        end
        
        -- ESP per il tesoro
        local treasure = FindTreasure()
        if treasure and treasure:IsA("BasePart") then
            CreateESP(treasure, Color3.fromRGB(0, 255, 0), "TREASURE")
        end
        
        wait(2)
    end
    ESPFolder:ClearAllChildren()
end

-- Fly System
local flying = false
local flySpeed = 50

local function Fly()
    local character = LocalPlayer.Character
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    if not hrp or not humanoid then return end
    
    local bv = Instance.new("BodyVelocity")
    bv.Name = "FlyVelocity"
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp
    
    local bg = Instance.new("BodyGyro")
    bg.Name = "FlyGyro"
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.P = 9e9
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp
    
    while flying do
        local camCF = Workspace.CurrentCamera.CFrame
        local direction = Vector3.zero
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            direction = direction + camCF.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            direction = direction - camCF.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            direction = direction - camCF.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            direction = direction + camCF.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            direction = direction + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            direction = direction - Vector3.new(0, 1, 0)
        end
        
        if direction.Magnitude > 0 then
            bv.Velocity = direction.Unit * flySpeed
        else
            bv.Velocity = Vector3.zero
        end
        
        bg.CFrame = camCF
        
        RunService.RenderStepped:Wait()
    end
    
    if hrp:FindFirstChild("FlyVelocity") then
        hrp.FlyVelocity:Destroy()
    end
    if hrp:FindFirstChild("FlyGyro") then
        hrp.FlyGyro:Destroy()
    end
end

