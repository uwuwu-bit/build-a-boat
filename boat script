-- Funzione per trovare Gold Blocks
local function GetGoldBlocks()
    local blocks = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "GoldBlock" or obj.Name:find("Gold")) then
            table.insert(blocks, obj)
        end
    end
    return blocks
end

-- Auto Farm Gold principale
local function AutoFarmLoop()
    while Settings.AutoFarm do
        local success, err = pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            -- Teleport agli stage
            if Stages then
                for i = 1, 10 do
                    if not Settings.AutoFarm then break end
                    
                    local stage = Stages:FindFirstChild("CaveStage" .. i) or 
                                 Stages:FindFirstChild("Stage" .. i)
                    
                    if stage then
                        local part = stage:FindFirstChildWhichIsA("BasePart")
                        if part then
                            hrp.CFrame = CFrame.new(part.Position.X, 50, part.Position.Z)
                            wait(0.5)
                        end
                    end
                end
            end
            
            -- Vai al tesoro (coordinate approssimative)
            hrp.CFrame = CFrame.new(0, 50, 9200)
            wait(0.5)
            
            -- Raccogli gold
            if ClaimGoldEvent then
                ClaimGoldEvent:FireServer()
            end
            
            wait(0.5)
            
            -- Reset
            char:BreakJoints()
        end)
        
        if not success then
            warn("Errore AutoFarm: " .. tostring(err))
        end
        
        wait(3) -- Attendi respawn
    end
end

-- Fast Farm (più veloce)
local function FastFarmLoop()
    while Settings.FastFarm do
        local success = pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            -- Teleport diretto al tesoro
            hrp.CFrame = CFrame.new(0, 100, 9200)
            wait(0.3)
            
            -- Raccogli gold multiple volte
            if ClaimGoldEvent then
                for i = 1, 3 do
                    ClaimGoldEvent:FireServer()
                    wait(0.1)
                end
            end
            
            wait(0.2)
            char:BreakJoints()
        end)
        
        wait(1.5) -- Respawn più veloce
    end
end

-- Auto Gold Blocks
local function GoldBlocksLoop()
    while Settings.AutoGoldBlocks do
        local success = pcall(function()
            local blocks = GetGoldBlocks()
            local char = LocalPlayer.Character
            if not char then return end
            
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            for _, block in pairs(blocks) do
                if not Settings.AutoGoldBlocks then break end
                if block and block.Parent then
                    hrp.CFrame = CFrame.new(block.Position + Vector3.new(0, 5, 0))
                    wait(0.2)
                    
                    -- Tocca il blocco
                    if block:FindFirstChild("TouchInterest") then
                        firetouchinterest(block, hrp, 0)
                        firetouchinterest(block, hrp, 1)
                    end
                    wait(0.1)
                end
            end
        end)
        
        wait(1)
    end
end

